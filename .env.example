PORT=3000

# Payment provider (Paystack is a common Ghana option)
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYMENT_CALLBACK_URL=http://localhost:3000/success.html

# Datamart data delivery provider
VTU_PROVIDER=datamart
DATAMART_BASE_URL=https://api.datamartgh.shop/api/developer
DATAMART_API_KEY=
DATAMART_API_SECRET=
# Ask Datamart for the authenticated order-status endpoint. Include {reference}.
DATAMART_STATUS_URL=
# Optional; minimum 15000 ms.
DELIVERY_REFRESH_INTERVAL_MS=60000
# Maximum Datamart status requests in one refresh cycle (150/minute limit).
DATAMART_MAX_STATUS_CHECKS_PER_RUN=140
DATAMART_DELIVERY_ESTIMATE_MINUTES=5
ADMIN_DASHBOARD_TOKEN=
ADMIN_EMAILS=
ADMIN_PASSWORD=
ADMIN_COOKIE_SECRET=
PUBLIC_APP_URL=http://localhost:3000

# Legacy Justice settings for switching back
VTU_BASE_URL=https://backend.justicedatashop.com
VTU_API_KEY=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RECEIPT_FROM=

# Optional webhook secrets
PAYMENT_WEBHOOK_SECRET=
DATAMART_WEBHOOK_SECRET=
VTU_WEBHOOK_SECRET=
